#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        //zmk,matrix_transform = &five_column_transform;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_adjust_layer {
            bindings = <&mo 3>;
            key-positions = <37 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&mo 1      &kp Q  &kp W  &kp E     &kp R             &kp T        &kp Y          &kp U  &kp I      &kp O    &kp P     &kp BSPC
&mo 2      &kp A  &kp S  &kp D     &kp F             &kp G        &kp H          &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V             &kp B        &kp N          &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RET
                         &kp LALT  &kp LEFT_CONTROL  &kp SPACE    &kp BACKSPACE  &mo 4  &mo 3
            >;
        };

        ONE {
            label = "1";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESC    &kp N1    &kp N2   &kp N3    &kp N4    &kp N5       &kp N6             &kp N7     &kp N8     &kp N9    &kp N0    &kp EQUAL
&trans     &kp EXCL  &kp AT   &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET          &kp AMPS   &kp STAR   &kp LPAR  &kp RPAR  &kp GRAVE
&kp LSHFT  &kp F13   &kp F14  &kp F15   &kp F16   &kp LBKT     &kp RIGHT_BRACKET  &kp MINUS  &kp EQUAL  &none     &none     &none
                              &kp LALT  &mo 1     &kp SPACE    &kp ENTER          &mo 3      &none
            >;
        };

        TWO {
            label = "2";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&mo 1      &kp INSERT  &kp UP_ARROW    &kp DEL     &kp HOME      &kp PAGE_UP      &kp F7     &kp EXCL   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PLUS   &kp F12
&trans     &kp LEFT    &kp DOWN_ARROW  &kp RIGHT   &kp END       &kp PAGE_DOWN    &kp COLON  &kp PLUS   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS  &none
&kp LSHFT  &none       &none           &kp DELETE  &kp END       &kp PG_DN        &kp F17    &kp UNDER  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SLASH  &kp F22
                                       &kp CLCK    &kp LEFT_GUI  &kp TILDE        &kp ENTER  &mo 2      &none
            >;
        };

        THREE {
            label = "3";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp K_COFFEE   &kp KP_NUMBER_7  &kp KP_N8  &kp KP_N9  &bt BT_SEL 0      &bt BT_SEL 1    &kp COMMA        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS      &kp KP_NUMLOCK
&bt BT_CLR     &kp KP_N4        &kp KP_N5  &kp KP_N6  &kp LG(LC(LEFT))  &none           &kp PERIOD       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_SUBTRACT  &kp TAB
&kp LC(LS(T))  &kp KP_N1        &kp KP_N2  &kp KP_N3  &kp LC(LS(TAB))   &none           &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DIVIDE    &kp KP_ENTER
                                           &kp LALT   &mo 3             &kp SPACE       &kp RET          &mo 3            &none
            >;
        };

        layer_4 {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5     &trans             &mkp MB1        &mmv MOVE_UP    &mkp MB2        &msc SCRL_UP    &msc SCRL_LEFT
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10    &kp C_VOLUME_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_DOWN  &msc SCRL_DOWN  &msc SCRL_RIGHT
&trans  &kp F11  &kp F12  &trans  &trans  &trans     &kp C_VOLUME_DOWN  &trans          &trans          &trans          &trans          &trans
                          &trans  &trans  &trans     &trans             &trans          &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        L4 {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };
};
